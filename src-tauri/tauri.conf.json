{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tico",
  "version": "1.0.0",
  "identifier": "com.victorsalmeron.tico",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "url": "index.html",
        "title": "Tico",
        "width": 680,
        "height": 440,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": true,
        "contentProtected": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Victor",
    "copyright": "© 2026 Victor. Código MIT; Tico es un personaje con derechos reservados.",
    "category": "Productivity",
    "shortDescription": "Isla dinámica de escritorio con Tico, un robot asistente",
    "longDescription": "Tico vive en el borde superior de la pantalla: al pasar el ratón baja una cápsula negra con un pequeño robot que chatea contigo y, solo cuando se lo pides, mira tu pantalla para ayudarte.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
